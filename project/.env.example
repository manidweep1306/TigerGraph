# ============================================================
# Agentic GraphRAG Hackathon — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- TigerGraph Savanna ---
# Get these from your Savanna dashboard at tgcloud.io
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_tigergraph_password
TG_GRAPH_NAME=OlympicGraphRAG
TG_SECRET=your_secret_here

# --- Application Settings ---
LOG_DIR=./logs
CONFIG_DIR=./config
CORPUS_PATH=../corpus-20260920T042835Z-1-001/corpus/corpus.jsonl
QUESTIONS_PUBLIC_PATH=../questions-20260920T040859Z-1-001/questions/eval_public.jsonl
QUESTIONS_HIDDEN_PATH=../questions-20260920T040859Z-1-001/questions/eval_hidden.jsonl

# --- Backend Server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# --- Ingestion Settings ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_BATCH_SIZE=20
INGEST_BATCH_SIZE=50
